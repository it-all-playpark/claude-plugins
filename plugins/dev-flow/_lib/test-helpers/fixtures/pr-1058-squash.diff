+        [[ "$output" == *"は議事録の保存先"*"の外です"* ]]
+        cmp "$note" "$BATS_TEST_TMPDIR/note.orig"
+        cmp "$tx" "$BATS_TEST_TMPDIR/tx.orig"
+        [ "$(cat "$outside/x.md")" = "話者A の秘密" ]
