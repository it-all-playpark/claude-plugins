# Claude Code / Serena / Codex
.claude/*
# plugin 配下の local 設定（.claude/* は root 固定パターンなので届かない）
plugins/*/.claude/settings.local.json
# Track dynamic workflow definitions (dev-flow / pr-iterate are Claude workflows)
!.claude/workflows/
!.claude/workflows/**
# Track path-scoped rules (dev-flow 内部仕様の遅延読み込み — AGENTS.md から分離)
!.claude/rules/
!.claude/rules/**
# Legacy: skill-config.json は現在リポジトリルートに配置
.serena/
.system/

# External agent skills（実体は plugin 配下。plugin 外を指す symlink は plugin install に拒否されるため）
plugins/playpark-skills/.agents/

# Credentials & secrets
client_secret.json
**/client_secret*.json
**/service-account*.json

# Environment variables (user-specific config)
.env

# Workspace config with token references (use *.example.json as template)
**/workspaces.json

# Generated reports
ga_report.json
trends_report.json
content_plan.json

# OAuth tokens (if stored locally)
**/ga_tokens*.json

# Trends cache
.trends_cache/

# Late API upload cache
.late-upload-cache.json

# Node (末尾 / を付けない — worktree 側の node_modules は main checkout への symlink で、
# `node_modules/` は directory にしかマッチせず symlink が untracked のまま残る)
node_modules

# Python
__pycache__/
*.pyc
*.pyo

# Packaged skills
*.skill

# veridelta run records (redgreen-verify.sh の vdelta run 経路の出力)
.veridelta/

# veridelta archived records (worktree-teardown.sh が worktree 削除前に退避)
.veridelta-archive/

# dev-flow ephemeral handoff files (must not be committed via git-commit --all)
.devflow-tmp/

# 作業者ローカルの設計メモ・計測・RCA（public repo に載せない。現行の不変条件は AGENTS.md / references が持つ）
claudedocs/

# --- external skills (auto-managed) ---
plugins/playpark-skills/agent-browser
plugins/playpark-skills/gsc
# --- end external skills ---
